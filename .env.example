# Copy to .env and fill in your Anthropic API key.
# .env is gitignored; .env.example is the template committed to the repo.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used by generate.py (all skills). Default: Haiku for speed. Try Opus for richness.
GEN_MODEL=claude-haiku-4-5-20251001

# Model used by evaluator.py. Haiku is the default — fast, cheap, and
# different from the main-session generator to reduce same-model bias.
EVALUATOR_MODEL=claude-haiku-4-5-20251001
